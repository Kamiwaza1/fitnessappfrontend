{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "strict": false,
    "types": ["cypress", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.js", "../cypress.config.js"]
}
